{
  "name": "CPI_Self_Healing_Hub",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.3",
    "@sap/cds": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "dummy"
      },
      "[production]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "auth": {
          "kind": "dummy"
        }
      }
    }
  }
}